# scripts/provision-gcp.env.example
#
# Config for scripts/provision-gcp.sh. Copy to scripts/provision-gcp.env,
# fill in, then `source scripts/provision-gcp.env` before running the
# script. This file (the .example) has no real values and is safe to
# commit; scripts/provision-gcp.env (without .example) is .gitignore'd —
# same convention as .env / .env.example.
#
# Only PROJECT_ID and DOMAIN are required; everything else has a
# documented default in scripts/provision-gcp.sh itself.

export PROJECT_ID=
export DOMAIN=

# export REGION=asia-south1
# export ZONE=asia-south1-a
# export VM_NAME=ai-housing-secretary
# export VM_MACHINE_TYPE=e2-medium

# Opt-in resources — see scripts/provision-gcp.sh's own comments for why
# these default to false.
# export PROVISION_DNS=true
# export PROVISION_CLOUD_SQL=true

# Secret values — leave unset to be prompted interactively (hidden input)
# when the script runs, rather than putting real secrets in this file.
# export GEMINI_API_KEY=
# export WHATSAPP_CLOUD_API_TOKEN=
# export JWT_SECRET=
# export FIELD_ENCRYPTION_KEY=
# export BACKUP_ENCRYPTION_KEY=
