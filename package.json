{
  "name": "ai-housing-secretary",
  "version": "0.1.0",
  "description": "AI-powered Housing Society Secretary Assistant built on the OpenClaw agent platform (WhatsApp + Gemini + GCP).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Kartavya Technology",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/db/migrations && cp -r src/db/migrations/* dist/db/migrations/",
    "dev": "tsx watch src/gateway/index.ts",
    "dev:worker": "tsx watch src/gateway/inboundWorker.ts",
    "dev:broadcast-worker": "tsx watch src/gateway/broadcastWorker.ts",
    "start": "node dist/gateway/index.js",
    "worker": "node dist/gateway/inboundWorker.js",
    "broadcast-worker": "node dist/gateway/broadcastWorker.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "knowledge:ingest": "tsx scripts/ingest-knowledge.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.3.0",
    "@google/generative-ai": "^0.21.0",
    "bullmq": "^6.0.9",
    "chromadb": "^1.10.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
