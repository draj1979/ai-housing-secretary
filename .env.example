# ==============================================================================
# AI Housing Society Secretary Assistant — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# See HLD sections 5, 14, 15 for the source requirements behind these vars.
# ==============================================================================

# --- App / Runtime ------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
APP_BASE_URL=https://secretary.example-society.in
LOG_RETENTION_DAYS=30
# Your domain (docs/deployment.md's "Clone the repo and configure
# secrets" step) — distinct from APP_BASE_URL above: this is the bare
# domain docker/docker-compose.yml's nginx service substitutes into
# nginx.conf.template (${DOMAIN}) for the TLS cert path/server_name.
# Confirmed live: leaving this unset makes nginx fall back to "_" and
# fail to find a certificate at all (cannot load certificate
# "/etc/letsencrypt/live/_/fullchain.pem") — not just a cosmetic default.
DOMAIN=secretary.example-society.in

# --- Gemini (LLM) --------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- WhatsApp Cloud API ---------------------------------------------------------
# Two numbers under one WABA (Sec 4): the public AI Secretary number
# (WHATSAPP_PHONE_NUMBER_ID — residents message this, AI sends from it) and
# the private Human Secretary number (WHATSAPP_SECRETARY_PHONE_NUMBER_ID —
# approvals/escalations). Both deliver to this app's one webhook.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Secretary's own WhatsApp phone number (E.164) — outbound "to" for escalation/notification sends
WHATSAPP_SECRETARY_NUMBER=
# The secretary number's phone_number_id — inbound routing (see comment above)
WHATSAPP_SECRETARY_PHONE_NUMBER_ID=
# Resident-facing society group id
WHATSAPP_SOCIETY_GROUP_ID=
# Overridable so tests/local dev can point the WhatsApp tool at a mock server
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
# Outbound Cloud API retry/backoff and broadcast fan-out (tools/whatsappTool.ts)
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_BASE_DELAY_MS=500
WHATSAPP_BROADCAST_CONCURRENCY=5
# BullMQ worker concurrency for inbound webhook events (gateway/inboundWorker.ts)
INBOUND_QUEUE_CONCURRENCY=5
# OpenClaw Gateway session idle timeout (gateway/session.ts), seconds. Default 30 min.
SESSION_IDLE_TIMEOUT_SECONDS=1800

# --- PostgreSQL (resident DB, complaints, memory) -------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_housing_secretary
DATABASE_SSL=false
# docker/docker-compose.yml's self-hosted `postgres` service reads its
# own password from this var (default "postgres", matching the
# DATABASE_URL above unchanged) — if you change DATABASE_URL's password
# for a real deployment, set this to the SAME value, or the app will
# never be able to authenticate (Postgres only applies POSTGRES_PASSWORD
# once, at first init of an empty data volume — the two silently drift
# apart otherwise, with no error until something actually tries to
# connect).
POSTGRES_PASSWORD=postgres

# --- Redis (cache, session state) ------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Vector DB / Embedding Store (Knowledge Base search, Sec 7.4) ---------------
# VECTOR_DB_PROVIDER: "chroma" | "pgvector"
VECTOR_DB_PROVIDER=pgvector
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=society_knowledge_base
# text-embedding-004 was shut down 2026-01-14 — gemini-embedding-001 is
# the replacement (3072-dim native output; see memory/embeddings.ts).
EMBEDDING_MODEL=gemini-embedding-001

# --- Auth / Security (Sec 15) ---------------------------------------------------
# Admin/dashboard JWTs (gateway/adminAuth.ts) — role-based access control
# (secretary | read_only) for /admin/* endpoints. Unset skips mounting
# /admin/* entirely (gateway/index.ts).
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Field-level encryption at rest for residents.phone_e164/emergency_contact
# (security/fieldEncryption.ts) — 32 bytes, base64. Generate with:
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- Google Cloud Platform (Sec 14) ----------------------------------------------
# scripts/provision-gcp.sh provisions everything below (and prints the
# exact values to fill in here once it finishes) — see docs/deployment.md.
GCP_PROJECT_ID=angular-unison-476906-s5
GCP_REGION=asia-south1
GCP_COMPUTE_ZONE=asia-south1-a
GCP_STATIC_IP_NAME=
# Only set if PROVISION_CLOUD_SQL=true was used (scripts/provision-gcp.sh) —
# self-hosted Postgres (docker-compose.yml's default `postgres` service)
# needs neither this nor the Cloud SQL Auth Proxy (docs/deployment.md).
GCP_CLOUD_SQL_INSTANCE_CONNECTION_NAME=
# Society documents (knowledge base source files, HLD Sec 7.4) bucket name
# — no gs:// prefix (contrast BACKUP_GCS_BUCKET below, which does use one).
GCP_STORAGE_BUCKET=
# Artifact Registry — where CI (scripts/gcp/setup-cicd.sh's github-deployer
# SA) pushes built images and docker-compose.yml's `image:` fields pull
# from (docker/docker-compose.yml). IMAGE_TAG is set per-deploy by CI
# (e.g. the git SHA); "latest" is only a reasonable default for local use.
AR_REPO_NAME=ai-housing-secretary
IMAGE_TAG=latest

# --- GCP Secret Manager references ------------------------------------------------
# Two ways secret values ever reach this file, never committed either way
# (see docs/deployment.md's "Secret flow" section for the full picture):
#   SECRETS_SOURCE=gcp — the app process itself resolves these
#     GCP_SECRET_* pointers into GEMINI_API_KEY/WHATSAPP_CLOUD_API_TOKEN/
#     JWT_SECRET/FIELD_ENCRYPTION_KEY (config/secrets.ts) at every boot.
#   SECRETS_SOURCE=env (the VM deploy path's default) — those same four
#     plaintext vars above are instead overwritten with real values by
#     scripts/gcp/remote-deploy.sh's refresh_secrets() on every deploy,
#     fetched from the exact same Secret Manager secrets below via the
#     *VM's own* service account (never GitHub Actions' deploy identity,
#     which has no Secret Manager role at all) — so by the time the app
#     boots there's nothing left to resolve. Pick whichever matches how
#     you're actually running this: gcp for anything that isn't
#     remote-deploy.sh-driven (e.g. a hypothetical Cloud Run deploy that
#     doesn't have a VM to run refresh_secrets() on), env for the VM path.
SECRETS_SOURCE=env
GCP_SECRET_GEMINI_API_KEY=projects/angular-unison-476906-s5/secrets/gemini-api-key/versions/latest
GCP_SECRET_WHATSAPP_TOKEN=projects/angular-unison-476906-s5/secrets/whatsapp-cloud-api-token/versions/latest
GCP_SECRET_DATABASE_URL=projects/angular-unison-476906-s5/secrets/database-url/versions/latest
GCP_SECRET_JWT_SECRET=projects/angular-unison-476906-s5/secrets/jwt-secret/versions/latest
GCP_SECRET_FIELD_ENCRYPTION_KEY=projects/angular-unison-476906-s5/secrets/field-encryption-key/versions/latest

# --- Backups (Sec 15, 17) ---------------------------------------------------------
# See docs/runbooks/backup-restore.md for the full pipeline and restore steps.
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_GCS_BUCKET=
# scripts/backup.sh's encryption passphrase — deliberately a *different*
# secret from FIELD_ENCRYPTION_KEY (docs/security.md's "Key separation").
BACKUP_ENCRYPTION_KEY=
